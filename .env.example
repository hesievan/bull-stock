# A股牛市热度指数 — 环境变量配置
# 复制为 .env 并填入你的 token

# Tushare API Token (必填)
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=your_token_here

# 飞书通知 Webhook (可选)
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 历史别名 FEISHU_WEBHOOK_URL 仍被兼容读取, 但请统一用 FEISHU_WEBHOOK

# Bark 推送 Key (可选, 取 https://api.day.app/<KEY> 中的 KEY)
# BARK_KEY=your_bark_key

# 环境切换: dev / prod (默认 prod)
# HEAT_INDEX_ENV=prod

# 数据库路径覆盖 (可选; 优先级高于 config 的 data.db_path)
# HEAT_INDEX_DB=data/heat_index.db

# 引擎计分模式覆盖 (可选; 优先级高于 config 的 v2_engine.mode)
# HEAT_ENGINE_MODE=single9
